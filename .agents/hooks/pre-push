#!/usr/bin/env bash
# ==============================================================================
# Agentic Era Networking — Pre-Push Gate
# ==============================================================================
# Enforces determinism, type-safety, and alignment invariants before any push
# reaches the remote repository.
#
# Install: npm run setup-hooks
# Bypass (emergencies only, with documented justification):
#   git push --no-verify
# ==============================================================================

set -euo pipefail

RESET="\033[0m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
BOLD="\033[1m"
CYAN="\033[0;36m"

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOCAL_LOG="$REPO_ROOT/.agents/.local-push.log"
TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo 'detached')"
COMMIT="$(git rev-parse --short HEAD 2>/dev/null || echo 'initial')"

echo ""
echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}${BOLD}║       Agentic Networking — AI Review Pre-Push Gate       ║${RESET}"
echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}"
echo -e "  Branch: ${BOLD}$BRANCH${RESET}  Commit: ${BOLD}$COMMIT${RESET}"
echo ""

# ── Read refs being pushed from stdin (standard Git pre-push protocol) ──
FILES_TO_SCAN=()

# Capture the push range so Gate 5 (AI Review) uses the same
# GITHUB_BEFORE..GITHUB_SHA diff that GitHub Actions will see — not just
# HEAD~1..HEAD (which only covers the last commit and diverges when multiple
# commits are pushed in a single push or after a force-push).
PUSH_BEFORE=""
PUSH_AFTER=""

if [ ! -t 0 ]; then
  while read -t 1 -r local_ref local_sha remote_ref remote_sha 2>/dev/null || [ -n "${local_ref:-}" ]; do
    [ -z "${local_sha:-}" ] && break

    if [[ "$local_sha" =~ ^0+$ ]]; then
      continue
    fi

    if [[ "$remote_sha" =~ ^0+$ ]]; then
      # New branch push — no established before-anchor; skip static file scanning
      # for this ref. Gate 5 (AI reviewer) handles new branches via its own
      # HEAD~1..HEAD fallback when PUSH_BEFORE is empty.
      [ -z "$PUSH_AFTER" ] && PUSH_AFTER="$local_sha"
      continue
    fi

    # Established range: same anchors as github.event.before..GITHUB_SHA.
    # Fail-closed: if git diff cannot resolve the range (corrupted index,
    # missing objects), block the push rather than silently scanning no files.
    if ! CHANGED=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null); then
      echo -e "  ${RED}✗ git diff $remote_sha..$local_sha failed — cannot determine push scope. Push blocked.${RESET}"
      exit 1
    fi
    if [ -n "$CHANGED" ]; then
      while IFS= read -r f; do
        [ -n "$f" ] && FILES_TO_SCAN+=("$f")
      done <<< "$CHANGED"
    fi

    # Note: for simultaneous multi-ref pushes (multiple branches in one push),
    # PUSH_BEFORE/PUSH_AFTER capture the first established ref's range. This is
    # the correct behaviour for this repository's single-branch-to-main workflow.
    # The AI reviewer (Gate 5) reviews the first ref's full commit range;
    # subsequent refs in the same push are covered by the FILES_TO_SCAN union
    # (Gates 3 & 4 still scan all changed files across all refs).
    [ -z "$PUSH_BEFORE" ] && PUSH_BEFORE="$remote_sha"
    [ -z "$PUSH_AFTER" ] && PUSH_AFTER="$local_sha"
  done
fi

if [ ${#FILES_TO_SCAN[@]} -eq 0 ]; then
  # No files collected via stdin (manual hook invocation or new-branch push).
  # Use PUSH_BEFORE..PUSH_AFTER if available (consistent with Gate 5 range);
  # fall back to @{u}...HEAD or HEAD~1..HEAD for static scanning only.
  # `|| true` is acceptable here: this path is for best-effort static scanning
  # on local manual invocations, not for the authoritative Gate 5 AI review.
  if [ -n "$PUSH_BEFORE" ] && [ -n "$PUSH_AFTER" ]; then
    CHANGED=$(git diff --name-only "$PUSH_BEFORE" "$PUSH_AFTER" 2>/dev/null || true)
  else
    CHANGED=$(git diff --name-only @{u}...HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD 2>/dev/null || true)
  fi
  if [ -n "$CHANGED" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && FILES_TO_SCAN+=("$f")
    done <<< "$CHANGED"
  fi
fi

UNIQUE_FILES=()
if [ ${#FILES_TO_SCAN[@]} -gt 0 ]; then
  while IFS= read -r f; do
    [ -n "$f" ] && UNIQUE_FILES+=("$f")
  done < <(printf '%s\n' "${FILES_TO_SCAN[@]}" | sort -u)
fi

PASS_COUNT=0
FAIL_COUNT=0
FAILURES=()

# ── Gate 1: TypeScript ─────────────────────────────────────
echo -e "${BOLD}[Gate 1/6] TypeScript — Zero suppressions, zero errors${RESET}"
if npm run check-types --silent 2>&1; then
  echo -e "  ${GREEN}✓ Type check passed across all packages${RESET}"
  PASS_COUNT=$((PASS_COUNT + 1))
else
  echo -e "  ${RED}✗ Type check FAILED${RESET}"
  FAIL_COUNT=$((FAIL_COUNT + 1))
  FAILURES+=("TypeScript check-types failed")
fi
echo ""

# ── Gate 2: Markdown Linting ──────────────────────────────
echo -e "${BOLD}[Gate 2/6] Markdown — Zero formatting defects across documentation${RESET}"
if npm run lint:md --silent 2>&1; then
  echo -e "  ${GREEN}✓ All markdown files conform to linting standards${RESET}"
  PASS_COUNT=$((PASS_COUNT + 1))
else
  echo -e "  ${RED}✗ Markdown linting FAILED${RESET}"
  echo -e "  ${YELLOW}  Run 'npm run lint:md:fix' or 'npm run lint:md' to resolve issues.${RESET}"
  FAIL_COUNT=$((FAIL_COUNT + 1))
  FAILURES+=("Markdown lint:md failed")
fi
echo ""

# ── Gate 3: Invariant Test Suite ──────────────────────────
echo -e "${BOLD}[Gate 3/6] Test Suite — All systems & invariants must hold${RESET}"
if npm run test --silent 2>&1; then
  echo -e "  ${GREEN}✓ All invariant and unit test suites passed${RESET}"
  PASS_COUNT=$((PASS_COUNT + 1))
else
  echo -e "  ${RED}✗ Tests FAILED${RESET}"
  FAIL_COUNT=$((FAIL_COUNT + 1))
  FAILURES+=("Invariant test suite failed")
fi
echo ""

# ── Gate 4: Determinism & Anti-Pattern Scan ───────────────
echo -e "${BOLD}[Gate 4/6] Determinism — Scanning pushed files for banned patterns${RESET}"

SUSPICIOUS_FINDINGS=""
UNIQUE_COUNT=${#UNIQUE_FILES[@]}

if [ "$UNIQUE_COUNT" -gt 0 ]; then
  for file in "${UNIQUE_FILES[@]}"; do
    [ -z "$file" ] && continue
    [ -f "$REPO_ROOT/$file" ] || continue
    case "$file" in
      *.ts|*.js|*.mjs)
        # Check for float arithmetic in packet/bandwidth/counter math
        FLOAT_MATCHES=$(grep -nE "(\bparseFloat\([^)]*(packet|byte|bandwidth|counter|rate|bps|pps|flow)|\b(packet|byte|bandwidth|counter|rate|bps|pps)[A-Za-z0-9_]*\s*(\*|\/)\s*0\.[0-9]+)" "$REPO_ROOT/$file" 2>/dev/null || true)
        if [ -n "$FLOAT_MATCHES" ]; then
          SUSPICIOUS_FINDINGS+="\n  ${BOLD}$file (Potential float arithmetic on packet/byte counters):${RESET}\n"
          while IFS= read -r m; do
            SUSPICIOUS_FINDINGS+="    $m\n"
          done <<< "$FLOAT_MATCHES"
        fi

        # Check for unvetted @ts-ignore
        TS_IGNORE=$(grep -nE "@ts-ignore" "$REPO_ROOT/$file" 2>/dev/null || true)
        if [ -n "$TS_IGNORE" ]; then
          SUSPICIOUS_FINDINGS+="\n  ${BOLD}$file (Forbidden @ts-ignore suppression):${RESET}\n"
          while IFS= read -r m; do
            SUSPICIOUS_FINDINGS+="    $m\n"
          done <<< "$TS_IGNORE"
        fi
        ;;
    esac
  done
fi

if [ -z "$SUSPICIOUS_FINDINGS" ]; then
  echo -e "  ${GREEN}✓ No banned anti-patterns detected in pushed files ($UNIQUE_COUNT inspected)${RESET}"
  PASS_COUNT=$((PASS_COUNT + 1))
else
  echo -e "  ${YELLOW}⚠ Determinism or suppression warnings found:${RESET}"
  echo -e "$SUSPICIOUS_FINDINGS"
  PASS_COUNT=$((PASS_COUNT + 1))
fi
echo ""

# ── Gate 5: Epistemic Provenance & Anti-Simulation Scan ──────
echo -e "${BOLD}[Gate 5/6] Epistemic Provenance — Programmatic audit & simulation scan${RESET}"

PROVENANCE_FAILURES=""

# 1. Programmatic Provenance Engine
if ! npm run check:provenance --silent 2>&1; then
  PROVENANCE_FAILURES+="  Programmatic check:provenance engine detected invariant violations.\n"
fi

# 2. Diff-level file scan for staged / pushed changes
if [ "$UNIQUE_COUNT" -gt 0 ]; then
  for file in "${UNIQUE_FILES[@]}"; do
    [ -z "$file" ] && continue
    [ -f "$REPO_ROOT/$file" ] || continue
    case "$file" in
      *.ts|*.js|*.mjs)
        case "$file" in
          test/*|*.test.ts|*.spec.ts|scripts/check-provenance.ts)
            ;;
          *)
            # Untagged mock hardware telemetry masquerading as live silicon
            MOCK_LEAK=$(grep -nE "CPU Temperature:\s*[0-9]+" "$REPO_ROOT/$file" 2>/dev/null || true)
            if [ -n "$MOCK_LEAK" ]; then
              if ! grep -qE "(SIMULATION|SANDBOX|cloud_snapshot|disconnected)" "$REPO_ROOT/$file" 2>/dev/null; then
                PROVENANCE_FAILURES+="\n  ${BOLD}$file (Untagged mock hardware telemetry masquerading as live silicon):${RESET}\n"
                while IFS= read -r m; do
                  PROVENANCE_FAILURES+="    $m\n"
                done <<< "$MOCK_LEAK"
              fi
            fi

            # Artificial constant counter increments (violating Goodhart's Law)
            ARTIFICIAL_INC=$(grep -nE "(rxBytes|txBytes|rxPackets|txPackets)\s*\+=\s*[0-9]+n?" "$REPO_ROOT/$file" 2>/dev/null || true)
            if [ -n "$ARTIFICIAL_INC" ]; then
              PROVENANCE_FAILURES+="\n  ${BOLD}$file (Artificial counter increment detected):${RESET}\n"
              while IFS= read -r m; do
                PROVENANCE_FAILURES+="    $m\n"
              done <<< "$ARTIFICIAL_INC"
            fi

            # Hardware probe mock return check (Invariants 3 & 6)
            if [[ "$file" == *"hardware-probe.ts" ]]; then
              PROBE_MOCK=$(grep -nE "createDefault(Coral|Jetson)Snapshot\s*\(\s*false\s*\)" "$REPO_ROOT/$file" 2>/dev/null || true)
              if [ -n "$PROBE_MOCK" ]; then
                PROVENANCE_FAILURES+="\n  ${BOLD}$file (Hardware probe returning mock presence isDisconnected=false):${RESET}\n"
                while IFS= read -r m; do
                  PROVENANCE_FAILURES+="    $m\n"
                done <<< "$PROBE_MOCK"
              fi

              PROBE_FALLBACK_TEMP=$(grep -nE "cpuC\s*:\s*[0-9]+(\.[0-9]+)?" "$REPO_ROOT/$file" 2>/dev/null || true)
              if [ -n "$PROBE_FALLBACK_TEMP" ]; then
                PROVENANCE_FAILURES+="\n  ${BOLD}$file (Hardware probe hardcoded fallback CPU temperature detected):${RESET}\n"
                while IFS= read -r m; do
                  PROVENANCE_FAILURES+="    $m\n"
                done <<< "$PROBE_FALLBACK_TEMP"
              fi
            fi

            # Coral thermal simulation check (Invariant 6)
            CORAL_THERMAL=$(grep -nE "(coral.*temperatureC\s*:\s*[0-9.]+|temperatureC\s*:\s*[0-9.]+\s*.*coral)" "$REPO_ROOT/$file" 2>/dev/null || true)
            if [ -n "$CORAL_THERMAL" ]; then
              PROVENANCE_FAILURES+="\n  ${BOLD}$file (Coral thermal simulation detected; must evaluate to null):${RESET}\n"
              while IFS= read -r m; do
                PROVENANCE_FAILURES+="    $m\n"
              done <<< "$CORAL_THERMAL"
            fi

            # Jetson UI status coupling check (Invariant 6)
            if [[ "$file" == *"zodiac-app.js" ]]; then
              ORIN_COUPLING=$(grep -nE "orin.*snapshot\.source\s*!==\s*['\"]disconnected['\"]" "$REPO_ROOT/$file" 2>/dev/null || true)
              if [ -n "$ORIN_COUPLING" ]; then
                PROVENANCE_FAILURES+="\n  ${BOLD}$file (Jetson UI status coupled to Zodiac switch serial state):${RESET}\n"
                while IFS= read -r m; do
                  PROVENANCE_FAILURES+="    $m\n"
                done <<< "$ORIN_COUPLING"
              fi
            fi
            ;;
        esac
        ;;
    esac
  done
fi

if [ -z "$PROVENANCE_FAILURES" ]; then
  echo -e "  ${GREEN}✓ Epistemic provenance verified: zero untagged mocks, verified transport origin${RESET}"
  PASS_COUNT=$((PASS_COUNT + 1))
else
  echo -e "  ${RED}✗ Epistemic provenance violation detected (Goodhart's Law):${RESET}"
  echo -e "$PROVENANCE_FAILURES"
  FAIL_COUNT=$((FAIL_COUNT + 1))
  FAILURES+=("Epistemic provenance violation (Goodhart's Law)")
fi
echo ""

# ── Gate 5: AI Review — AI loop until clean ─────────
# Runs the AI Review in --strict mode (blocks on Warnings as well as
# Critical Issues). Retries up to 3 times: if the first pass has issues,
# the developer is expected to fix them and re-run; the hook re-evaluates
# the diff after each fix attempt. Passes only when the reviewer exits 0.
#
# Exit codes from ai-reviewer.mjs:
#   0 = clean (no Critical Issues, no Warnings)
#   1 = Critical Issues (❌ CHANGES REQUESTED)
#   2 = Warnings only (🟠) in strict mode
#   non-zero but no API key = skipped gracefully (exit 0 via reviewer)
echo -e "${BOLD}[Gate 6/6] AI Review — AI code review (strict: no warnings, no criticals)${RESET}"

# Cost control: skip the (potentially cloud-billed) AI review entirely when every changed file is
# docs/non-code, matching .github/workflows/ai-review.yml's paths-ignore exactly so local and CI
# behavior agree. Requires FILES_TO_SCAN to be non-empty -- an empty list means we could not determine
# scope (new branch, detached push), and a gate that cannot determine scope must not skip itself.
is_docs_only_push() {
  local f
  if [ ${#FILES_TO_SCAN[@]} -eq 0 ]; then
    return 1
  fi
  for f in "${FILES_TO_SCAN[@]}"; do
    case "$f" in
      *.md|.gitignore|scratch/*|.env*) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

if is_docs_only_push; then
  echo -e "  ${GREEN}✓ Skipped — push touches only docs/non-code files (same paths-ignore as .github/workflows/ai-review.yml):${RESET}"
  printf '      %s\n' "${FILES_TO_SCAN[@]}"
  COUNCIL_PASS=true
  PASS_COUNT=$((PASS_COUNT + 1))
else
  COUNCIL_PASS=false
  COUNCIL_ATTEMPT=0
  MAX_COUNCIL_ATTEMPTS=3

  while [ "$COUNCIL_ATTEMPT" -lt "$MAX_COUNCIL_ATTEMPTS" ]; do
    COUNCIL_ATTEMPT=$((COUNCIL_ATTEMPT + 1))

    if [ "$COUNCIL_ATTEMPT" -gt 1 ]; then
      echo ""
      echo -e "${YELLOW}  ↻ AI Review attempt ${COUNCIL_ATTEMPT}/${MAX_COUNCIL_ATTEMPTS} — re-evaluating after fixes...${RESET}"
      echo ""
    fi

    # Capture exit code without aborting the script (set -e is active).
    # Export GITHUB_BEFORE/GITHUB_SHA so the reviewer uses the same diff range
    # as GitHub Actions (PUSH_BEFORE..PUSH_AFTER rather than HEAD~1..HEAD),
    # ensuring local and CI reviews are identical for multi-commit pushes.
    COUNCIL_EXIT=0
    GITHUB_BEFORE="$PUSH_BEFORE" GITHUB_SHA="$PUSH_AFTER" \
      node "$REPO_ROOT/scripts/ai-reviewer.mjs" --last --strict --skip-ollama || COUNCIL_EXIT=$?

    if [ "$COUNCIL_EXIT" -eq 0 ]; then
      echo -e "  ${GREEN}✓ AI Review passed — no Critical Issues or Warnings${RESET}"
      COUNCIL_PASS=true
      PASS_COUNT=$((PASS_COUNT + 1))
      break
    elif [ "$COUNCIL_EXIT" -eq 1 ]; then
      echo -e "  ${RED}✗ AI Review: Critical Issues detected${RESET}"
      if [ "$COUNCIL_ATTEMPT" -lt "$MAX_COUNCIL_ATTEMPTS" ]; then
        echo -e "  ${YELLOW}  Fix the Critical Issues above, then run: git commit --amend && git push${RESET}"
        echo -e "  ${YELLOW}  The hook will re-evaluate automatically on next push.${RESET}"
      fi
    elif [ "$COUNCIL_EXIT" -eq 2 ]; then
      echo -e "  ${YELLOW}⚠ AI Review: Warnings detected${RESET}"
      if [ "$COUNCIL_ATTEMPT" -lt "$MAX_COUNCIL_ATTEMPTS" ]; then
        echo -e "  ${YELLOW}  Resolve the Warnings above, then re-push.${RESET}"
      fi
    else
      # Fail-closed (Hassabis: Verification Asymmetry / Fail-Closed Bounds):
      # Any exit code other than 0, 1, or 2 means the reviewer itself crashed
      # (OOM, uncaught exception, SIGKILL, command-not-found, etc.).
      # A verification gate that cannot execute MUST block the push, not silently
      # pass. If AI APIs are unavailable, the reviewer exits 0 internally before
      # Node even exits abnormally — this path is a genuine runtime failure.
      echo -e "  ${RED}✗ AI Review crashed (exit code $COUNCIL_EXIT). Push blocked.${RESET}"
      echo -e "  ${YELLOW}  Check that node is installed and GEMINI_API_KEY / ANTHROPIC_API_KEY is set.${RESET}"
      echo -e "  ${YELLOW}  Emergency bypass (audited): git push --no-verify${RESET}"
    fi
  done

  if [ "$COUNCIL_PASS" = false ]; then
    FAIL_COUNT=$((FAIL_COUNT + 1))
    FAILURES+=("AI Review: unresolved Critical Issues or Warnings after ${MAX_COUNCIL_ATTEMPTS} attempts")
  fi
fi

echo ""

# ── Summary ───────────────────────────────────────────────
echo -e "${BOLD}Results: ${GREEN}$PASS_COUNT passed${RESET} ${BOLD}/ ${RED}$FAIL_COUNT failed${RESET}"
echo ""

mkdir -p "$(dirname "$LOCAL_LOG")"
FAIL_STR="${FAILURES[*]:-none}"
echo "[$TIMESTAMP] branch=$BRANCH commit=$COMMIT passed=$PASS_COUNT failed=$FAIL_COUNT failures='$FAIL_STR'" >> "$LOCAL_LOG"

if [ "$FAIL_COUNT" -gt 0 ]; then
  echo -e "${RED}${BOLD}✗ Pre-push gate BLOCKED${RESET}"
  echo -e "  Failures: $FAIL_STR"
  echo ""
  echo -e "  Fix the above failures before pushing."
  echo -e "  Emergency bypass (audited): ${YELLOW}git push --no-verify${RESET}"
  exit 1
fi

echo -e "${GREEN}${BOLD}✓ All gates passed. Push proceeding.${RESET}"
echo ""
