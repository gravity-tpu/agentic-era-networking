{
  "name": "agentic-era-networking",
  "version": "0.1.0",
  "description": "Agentic Era Networking: Autonomous monitoring, DNS, Software Defined Networking (SDN), and telemetry",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "check:provenance": "node --experimental-strip-types scripts/check-provenance.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "review": "node scripts/ai-reviewer.mjs",
    "review:staged": "node scripts/ai-reviewer.mjs",
    "review:last": "node scripts/ai-reviewer.mjs --last",
    "review:head": "node scripts/ai-reviewer.mjs --head",
    "setup-hooks": "bash scripts/install-hooks.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "zodiac": "node --experimental-strip-types scripts/zodiac-cli.ts",
    "serve": "node --experimental-strip-types scripts/zodiac-cli.ts serve",
    "dev": "node --experimental-strip-types scripts/zodiac-cli.ts serve"
  },
  "keywords": [
    "networking",
    "sdn",
    "dns",
    "monitoring",
    "agentic-ai",
    "determinism",
    "telemetry"
  ],
  "author": "gravity-tpu",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^7.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
