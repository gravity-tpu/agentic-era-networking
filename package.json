{
  "name": "agentic-era-networking",
  "version": "0.1.0",
  "description": "Zodiac: a real-hardware testbed and verifier for agent-proposed SDN policy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc && node --experimental-strip-types scripts/build-assets.ts",
    "build:server": "prisma generate && tsc",
    "build:assets": "node --experimental-strip-types scripts/build-assets.ts",
    "check-types": "tsc --noEmit && tsc --project tsconfig.api.json --noEmit",
    "check:provenance": "node --experimental-strip-types scripts/check-provenance.ts",
    "lint:md": "markdownlint -c .markdownlint.json \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint -c .markdownlint.json --fix \"**/*.md\" --ignore node_modules",
    "lint": "npm run check-types && npm run lint:md",
    "test": "vitest run",
    "test:watch": "vitest",
    "council:review": "node scripts/ai-reviewer.mjs",
    "council:review:last": "node scripts/ai-reviewer.mjs --last",
    "council:review:head": "node scripts/ai-reviewer.mjs --head",
    "council:review:strict": "node scripts/ai-reviewer.mjs --strict",
    "ccie:review": "node scripts/ai-reviewer.mjs --ccie",
    "ccie:review:last": "node scripts/ai-reviewer.mjs --ccie --last",
    "ccie:review:head": "node scripts/ai-reviewer.mjs --ccie --head",
    "ccie:review:strict": "node scripts/ai-reviewer.mjs --ccie --strict",
    "review": "node scripts/ai-reviewer.mjs",
    "review:staged": "node scripts/ai-reviewer.mjs",
    "review:last": "node scripts/ai-reviewer.mjs --last",
    "review:head": "node scripts/ai-reviewer.mjs --head",
    "setup-hooks": "bash scripts/install-hooks.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "zodiac": "node --experimental-strip-types scripts/zodiac-cli.ts",
    "burst": "node --experimental-strip-types scripts/burst-cli.ts start",
    "burst:status": "node --experimental-strip-types scripts/burst-cli.ts status",
    "burst:stop": "node --experimental-strip-types scripts/burst-cli.ts stop",
    "serve": "node --experimental-strip-types scripts/zodiac-cli.ts serve",
    "dev": "node --experimental-strip-types scripts/zodiac-cli.ts serve",
    "gpu:build": "mkdir -p build && /usr/local/cuda/bin/nvcc -O3 -arch=sm_87 -shared -Xcompiler -fPIC src/gpu/gpu_anomaly_kernel.cu -o build/libgpu_anomaly.so",
    "gpu:sentinel": "python3 scripts/gpu-sdn-anomaly-sentinel.py",
    "switch:workload": "bash scripts/netgear-tunnel.sh 1",
    "switch:uplink": "bash scripts/netgear-tunnel.sh 2",
    "switch:stop": "bash scripts/netgear-tunnel.sh stop",
    "switch:status": "bash scripts/netgear-tunnel.sh status",
    "switch:service:install": "bash scripts/netgear-tunnel.sh install-service",
    "switch:service:uninstall": "bash scripts/netgear-tunnel.sh uninstall-service",
    "switch:service:status": "bash scripts/netgear-tunnel.sh service-status",
    "switch:service:restart": "bash scripts/netgear-tunnel.sh service-restart",
    "workstation:agent": "node --experimental-strip-types scripts/workstation-agent.ts",
    "bench:dataplane": "node --experimental-strip-types scripts/zodiac-dataplane-bench.ts",
    "probe:flows": "node --experimental-strip-types scripts/zodiac-flow-probe.ts",
    "bench:calibrate": "node --experimental-strip-types scripts/calibrate-capture.ts"
  },
  "keywords": [
    "networking",
    "sdn",
    "dns",
    "monitoring",
    "agentic-ai",
    "determinism",
    "telemetry"
  ],
  "author": "gravity-tpu",
  "license": "Apache-2.0",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "happy-dom": "^21.0.3",
    "markdownlint-cli": "^0.49.1",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^5.4.1",
    "katex": "^0.18.2",
    "mysql2": "^3.24.4",
    "smol-toml": "^1.9.0"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
