# ==============================================================================
# Agentic Era Networking — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================================

# AI Reviewer & Agent Keys (Multi-model fallback chain)
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Database (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# Vercel Deployment (Optional / CI-CD)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# Networking & Telemetry Node Config
NODE_ENV="development"
NETWORK_INTERFACE="eth0"
METRICS_PORT="9090"
LOG_LEVEL="info"

# Physical Hardware SDN Topology (Customize in .env.local; never commit real IPs)
JETSON_HOST=""
ZODIAC_SWITCH_IP=""
SDN_CONTROLLER_IP=""
SDN_GATEWAY_IP=""
ZODIAC_OPENFLOW_PORT="6633"
ZODIAC_SERIAL_PATH="/dev/ttyACM0"
ZODIAC_BRIDGE_SECRET=""
ZODIAC_CLOUD_RELAY_URL="https://agentic-era-networking.vercel.app"

