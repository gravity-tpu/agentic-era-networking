{
  "version": 2,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/prune-telemetry",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.[a-f0-9]{10}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html|)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/zodiac/flows", "destination": "/api/zodiac?section=flows" }
  ],
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then echo 'Deployment delegated to GitHub Actions AI Review gate' && exit 0; else exit 1; fi"
}
