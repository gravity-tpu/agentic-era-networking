generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Invariant: Counter metrics use 64-bit integer (BigInt) precision
model NetworkTelemetry {
  id              String   @id @default(uuid())
  interfaceName   String
  packetsIngress  BigInt
  packetsEgress   BigInt
  bytesIngress    BigInt
  bytesEgress     BigInt
  droppedPackets  BigInt
  timestampNs     BigInt
  createdAt       DateTime @default(now())

  @@index([interfaceName, createdAt])
}

// Invariant: All DNS resolutions logged with nanosecond latency and fail-closed RCODE
model DnsQueryLog {
  id            String   @id @default(uuid())
  hostname      String
  recordType    String
  clientIp      String
  responseCode  String   // NOERROR, NXDOMAIN, NODATA, REJECTED
  resolvedValue String?
  latencyNs     BigInt
  createdAt     DateTime @default(now())

  @@index([hostname, createdAt])
  @@index([responseCode])
}

// Invariant: SDN flow rules with priority and default-drop action
model FlowRule {
  id         String   @id @default(uuid())
  tenantId   String
  priority   Int      @default(100)
  srcCidr    String   // e.g. "10.0.0.0/24"
  dstCidr    String   // e.g. "192.168.1.0/24"
  protocol   String   // TCP, UDP, ICMP, ANY
  srcPort    Int?     // null = ANY
  dstPort    Int?     // null = ANY
  action     String   // FORWARD, DROP, QUARANTINE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, priority])
  @@index([action])
}

// Council Invariant 2 & 6: 64-bit integer telemetry persistence with physical provenance
model ZodiacTelemetryPoint {
  id              String   @id @default(uuid())
  timestampMs     BigInt
  source          String   // 'live_hardware' | 'cloud_snapshot' | 'disconnected'
  cpuTemperatureC Int?
  latencyNs       BigInt
  totalRxBytes    BigInt
  totalTxBytes    BigInt
  totalRxPackets  BigInt
  totalTxPackets  BigInt
  rxRatePps       BigInt
  txRatePps       BigInt
  rxRateBps       BigInt
  txRateBps       BigInt
  portsJson       Json     // Full snapshot of Ports 1-4 counters and link status
  jetsonJson      Json?    // NVIDIA Jetson Orin Nano host vitals, thermals, NICs
  coralJson       Json?    // Google Coral Edge TPU inference rates, latencies
  workstationJson Json?    // MacBook M5 GPU/CPU utilization, token throughput, memory
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([timestampMs])
}

// The single latest snapshot the bridge pushed, as received (BigInt as strings, each series cut to its newest point).
// A cold serverless instance hydrates from this row instead of inventing defaults. Only live snapshots are written.
model ZodiacLatestSnapshot {
  id           String   @id
  timestampMs  BigInt
  source       String   // always 'live_hardware': a non-live push never overwrites this row
  snapshotJson Json
  updatedAt    DateTime @updatedAt
}

// Operator identity for Google SSO authentication guard
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  picture     String?
  role        String   @default("operator") // "admin" | "operator" | "viewer"
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([email])
}
