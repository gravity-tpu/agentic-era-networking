<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zodiac.bridge-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Populated with repo root by 'npm run bridge:service:install' -->
        <string>/path/to/agentic-era-networking/deploy/mac/zodiac-bridge-tunnel-supervisor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/zodiac-bridge-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/zodiac-bridge-tunnel.log</string>
</dict>
</plist>

