# zodiac-bridge.env.template
# Environment variables for the Zodiac FX SDN Bridge Daemon on Jetson Orin.
#
# USAGE:
#   1. cp zodiac-bridge.env.template /etc/zodiac/zodiac-bridge.env
#   2. chmod 600 /etc/zodiac/zodiac-bridge.env
#   3. chown zodiac:zodiac /etc/zodiac/zodiac-bridge.env
#   4. Fill in all <REPLACE_ME> values.
#   5. sudo systemctl restart zodiac-bridge
#
# Council Invariant 6 (Epistemic Provenance):
#   Every secret here corresponds to a verified physical or cryptographic
#   principal. There are no synthetic or placeholder values in production.

# ─── Zodiac FX Hardware ───────────────────────────────────────────────────────
# Serial port of the Zodiac FX Micro-USB CDC-ACM interface on the Jetson.
# Auto-detected as /dev/ttyACM0 if left unset, but setting it explicitly
# eliminates any ambiguity when multiple USB-serial devices are attached.
ZODIAC_SERIAL_PATH=/dev/ttyACM0

# Static IP of the Zodiac FX switch on the management LAN segment.
ZODIAC_HOST=<switch-ip>

# Static IP of the Jetson SDN Controller interface.
SDN_CONTROLLER_IP=<controller-ip>

# Default gateway IP for the SDN subnet.
SDN_GATEWAY_IP=<gateway-ip>

# OpenFlow 1.3 controller listen port (must match Zodiac FX config).
ZODIAC_OPENFLOW_PORT=6633

# ─── Cloud Telemetry Relay ────────────────────────────────────────────────────
# Vercel production URL that receives POST /api/zodiac telemetry pushes.
ZODIAC_CLOUD_RELAY_URL=https://agentic-era-networking.vercel.app

# 256-bit cryptographic secret shared between the Jetson bridge and Vercel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match ZODIAC_BRIDGE_SECRET in Vercel environment variables exactly.
ZODIAC_BRIDGE_SECRET=<REPLACE_ME>

# ─── Neon Serverless Postgres ─────────────────────────────────────────────────
# Neon DB pooled connection string for 30-day telemetry persistence.
# Format: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=<REPLACE_ME>

# ─── Google OAuth (SSO Dashboard Guard) ──────────────────────────────────────
# Required only if the local bridge server (:3003) needs to enforce SSO locally.
# The Vercel production endpoint always requires these.
GOOGLE_CLIENT_ID=<REPLACE_ME>
GOOGLE_CLIENT_SECRET=<REPLACE_ME>
SESSION_SECRET=<REPLACE_ME>

# Comma-separated list of authorized Google account emails.
# Wildcards supported: *@yourdomain.com
ALLOWED_GOOGLE_EMAILS=sekyereandy@gmail.com,natborks@gmail.com

# ─── Lifecycle (Invariant 3, fail closed) ────────────────────────────────────
# By default the bridge exits non-zero if it cannot bind the OpenFlow port (6633), so systemd shows the unit as
# failed instead of `active` for a bridge that controls no switch. Development only: allow a degraded start.
# Only the literal value 1 enables it.
# ZODIAC_ALLOW_DEGRADED_CONTROL_PLANE=1

# ─── Workstation (Mac) agent ─────────────────────────────────────────────────
# Where the bridge probes the Mac's workstation agent (scripts/workstation-agent.ts, kept running by the LaunchAgent in
# deploy/macos/). Comma-separated; tried at the same time with the USB-C tether and WORKSTATION_AGENT_LAN_URL. Prefer the
# Mac's Tailscale address: it is stable, and the agent binds it. Read when the bridge starts.
# WORKSTATION_AGENT_URL=http://100.x.y.z:11435

# ─── Isolation re-check ──────────────────────────────────────────────────────
# How often the bridge re-reads the switch's flow table to re-verify the isolation policy after install (read-only,
# one small request per interval). Default 60000 ms; allowed range 10000..3600000; the exact value 0 disables it.
# Any other value is a startup error, so a typo cannot silently turn verification off.
# ZODIAC_ISOLATION_RECHECK_INTERVAL_MS=60000

# ─── Coral TPU (Phase 2A — populate when Coral is integrated) ─────────────────
# The Coral inference daemon is opt-in: the bridge does not spawn it unless this is 1 (the Corals are parked).
# A child of the bridge shares its fate; if a Coral is attached again, prefer the separate zodiac-coral.service.
# ZODIAC_ENABLE_CORAL_DAEMON=1
# USB bus path of the Google Coral Edge TPU on the Jetson.
# Detected automatically via libedgetpu; set explicitly to pin a specific device.
# CORAL_DEVICE_PATH=/dev/bus/usb/001/002

# Inference confidence threshold below which Coral classifications are dropped.
# Range: 0.0–1.0. Lower = more sensitive, higher = fewer false positives.
# CORAL_CONFIDENCE_THRESHOLD=0.85

# ─── Quarantine: mode and envelope ───────────────────────────────────────────────────────────
# The bridge is the single place that decides what happens to a quarantine request from ANY detector (the trt daemon,
# the GPU sentinel, ...). Requests are accepted only from the bridge host itself (loopback, no proxy headers): both detectors default to
# http://127.0.0.1:3003, and pointing one at a non-loopback BRIDGE_URL or SDN_CONTROLLER_URL gets a 403 not_local. ZODIAC_QUARANTINE_MODE=propose (the default) records the request as a proposal and installs
# nothing; list them with GET /api/sdn/quarantine/proposals and approve one with
#   curl -X POST localhost:3003/api/sdn/quarantine/approve -d '{"targetIp":"10.0.2.50"}'
# Only the exact value `enforce` installs without a person (still inside the envelope below, time-limited).
# ZODIAC_QUARANTINE_MODE=propose
# The bridge installs a quarantine DROP only for one source IPv4 inside 10.0.2.0/24, never a protected host, at most
# MAX_ACTIVE at once, and removes it after the time limit (also in propose mode: a proposal is checked against
# the same envelope, and approval is too). List hosts that must never be blocked (comma-separated
# IPv4; a malformed entry makes the bridge refuse every quarantine). Defaults: 300000 ms, 8 active.
# ZODIAC_QUARANTINE_PROTECTED_IPS=10.0.2.119
# ZODIAC_QUARANTINE_TTL_MS=300000
# ZODIAC_QUARANTINE_MAX_ACTIVE=8

# ─── Offline / CI Testing Only ────────────────────────────────────────────────
# MOCK_SERIAL=1 bypasses physical Zodiac FX serial detection and returns
# /dev/null instead. NEVER set this in a production /etc/zodiac/zodiac-bridge.env.
# It exists solely to allow unit tests and CI pipelines to run without hardware.
# Council Invariant 1 (Anti-Shortcut Law): setting this in production masks the
# "Device Not Found" error and silently breaks serial CDC-ACM telemetry.
# MOCK_SERIAL=1

# ─── Install gate: throughput target and audit trail ─────────────────────────────────────────
# ZODIAC_CAPACITY_TARGET_PPS declares the packets per second (at ZODIAC_CAPACITY_PAYLOAD_BYTES, default 572, the only payload the deployed table
# was measured at) the table must sustain at the quarantine envelope's full depth. Unset means no target and A8 is a note. 7900 is the largest round
# number that passes at the default cap of 8 quarantines. It is enforced on the allow route and advisory (logged and audited) for quarantines and the
# startup policy.
# ZODIAC_CAPACITY_TARGET_PPS=7900
# Every refusal by the gate, and every advisory shortfall, is appended to this JSON-lines file (default $STATE_DIRECTORY/install-gate-audit.jsonl,
# else /var/lib/zodiac/install-gate-audit.jsonl; the file rotates once at 5 MiB, keeping one previous file, so at most about 10 MiB on disk; at most 60 lines
# a minute, and events beyond that are counted and logged, not written).
# ZODIAC_GATE_AUDIT_FILE=/var/lib/zodiac/install-gate-audit.jsonl
