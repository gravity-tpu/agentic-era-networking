# zodiac-bridge.service
# Zodiac FX SDN Bridge Daemon — Jetson Orin Nano Super (Headless, 24/7)
#
# Council Invariants Enforced:
#   Dean:    Restart backoff caps at 60s; never floods the UART or TCP stack.
#   Ghemawat: Minimal unit — no extra tooling or wrapper scripts.
#   Hassabis: Fail-closed isolation: if the daemon dies, the switch falls
#             back to its own hardware fail-safe, never forwarding blindly.
#
# Installation (run on Jetson as root):
#   sudo cp zodiac-bridge.service /etc/systemd/system/
#   sudo cp zodiac-bridge.env     /etc/zodiac/zodiac-bridge.env
#   sudo chmod 600                /etc/zodiac/zodiac-bridge.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zodiac-bridge
#
# Live log tail:
#   journalctl -u zodiac-bridge -f
#
# Manual restart:
#   sudo systemctl restart zodiac-bridge

[Unit]
Description=Zodiac FX SDN Control-Plane Bridge — Agentic Era Networking
Documentation=https://github.com/gravity-tpu/agentic-era-networking
After=network-online.target
Wants=network-online.target
# If the Neon DB or Vercel relay is unavailable at boot, the service still
# starts — cloud relay failures are non-fatal (AbortSignal-guarded, 3s timeout).

[Service]
# Type=notify: systemd waits for READY=1 via $NOTIFY_SOCKET before marking
# the service active and starting any downstream dependents. This eliminates
# the TOCTOU window where dependents start before the HTTP server is bound.
# The bridge server sends READY=1 via the native sdNotify() helper in
# src/sdn/zodiac-bridge-server.ts immediately after srv.listen() resolves.
Type=notify
User=zodiac
Group=zodiac

# --- Working directory & Node binary ---
# Adjust WorkingDirectory if the repo is cloned elsewhere on the Jetson.
WorkingDirectory=/home/zodiac/agentic-era-networking

# Prefer the project-local node binary; fall back to system node.
# --max-old-space-size=128: forces V8 garbage collection at 128MB, well below
# the MemoryMax=256M cgroup hard limit. Without this flag, V8 may attempt to
# grow the heap beyond 256MB before triggering GC, causing an abrupt OOM kill
# by the kernel rather than a clean GC cycle (Quoc Le / Ghemawat invariant).
ExecStart=/usr/bin/env node --max-old-space-size=128 dist/sdn/zodiac-bridge-server.js serve 3003

# --- Environment ---
# Secrets are stored in a chmod-600 env file, never in the unit itself.
# Copy deploy/jetson/zodiac-bridge.env.template → /etc/zodiac/zodiac-bridge.env
# and populate all values before enabling this unit.
EnvironmentFile=/etc/zodiac/zodiac-bridge.env

# Force Node.js production mode so no dev-only logging leaks to journald.
Environment=NODE_ENV=production

# --- Restart policy (Dean Invariant: bounded exponential backoff) ---
# Restart on any non-zero exit or SIGTERM; not on SIGKILL (catastrophic).
Restart=on-failure
RestartSec=5s
# Cap restart burst: 5 restarts in 60s triggers a cooldown to prevent
# UART flood or switch TCP RST storms from spinning the CPU.
StartLimitIntervalSec=60s
StartLimitBurst=5

# --- Resource limits (Ghemawat: zero-bloat, no runaway memory) ---
# Jetson Orin Nano Super has 8 GB unified LPDDR5X.
# The bridge daemon should never exceed 256 MB resident; alert if it does.
MemoryMax=256M
MemorySwapMax=0

# Lock in real-time scheduling class for the OpenFlow control loop.
# CAP_NET_BIND_SERVICE allows binding to privileged port 6633 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Harden the execution environment.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The bridge writes nothing to disk at runtime; all state is in-memory or Neon.
ReadWritePaths=/tmp

# --- Watchdog (Dean: kernel-level liveness guarantee, zero external deps) ---
# WatchdogSec=30s: systemd kills and restarts the process if it does not
# send WATCHDOG=1 to $NOTIFY_SOCKET within 30 seconds.
#
# The bridge server calls sdNotify('WATCHDOG=1') every 10 seconds (3x margin).
# The 30s budget absorbs Neon DB cold-start latency and transient WAN blips
# without triggering a false-positive restart. A genuine event-loop hang
# (e.g. deadlocked mutex, infinite recursion) will surface within 30s.
#
# Implementation: pure node:dgram fire-and-forget datagram to $NOTIFY_SOCKET.
# Zero external packages. See sdNotify() in src/sdn/zodiac-bridge-server.ts.
WatchdogSec=30s

# --- Logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zodiac-bridge

[Install]
WantedBy=multi-user.target
