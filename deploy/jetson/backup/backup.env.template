# /etc/zodiac/backup.env  (root:root, mode 0640). No secrets here: the password lives in its own file.
#
# Restic repository on Google Drive through rclone (remote name "gdrive" in the rclone config below).
RESTIC_REPOSITORY=rclone:gdrive:zodiac-jetson-backup
RESTIC_PASSWORD_FILE=/etc/zodiac/restic-password
RCLONE_CONFIG=/etc/zodiac/rclone.conf

# Retention (applied after every run; pruning runs weekly, on Sundays)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Extra absolute paths to include, space separated (optional)
EXTRA_PATHS=""
