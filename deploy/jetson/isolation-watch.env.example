# /etc/zodiac/isolation-watch.env (mode 600, owner root). The topic below IS the secret on the public ntfy.sh server: make it long and random
# (openssl rand -hex 16), subscribe to it in the ntfy phone app, and never paste it into a chat, an issue or the repository.
ISOLATION_WATCH_NTFY_URL=https://ntfy.sh/zodiac-CHANGE-ME-to-a-long-random-string
# Only for a self-hosted ntfy server with access control:
#ISOLATION_WATCH_NTFY_TOKEN=
# Defaults shown; every one is bounded (see src/sdn/isolation-watch.ts):
#ISOLATION_WATCH_BRIDGE_URL=http://127.0.0.1:3003
#ISOLATION_WATCH_POLL_MS=60000
#ISOLATION_WATCH_BAD_POLLS=5
#ISOLATION_WATCH_CRITICAL_POLLS=2
#ISOLATION_WATCH_UNREACHABLE_POLLS=3
#ISOLATION_WATCH_CLEAN_POLLS=2
#ISOLATION_WATCH_MAX_CHECK_AGE_MS=300000
#ISOLATION_WATCH_REALERT_MS=1800000
#ISOLATION_WATCH_MAX_REMINDERS=8
#ISOLATION_WATCH_HEARTBEAT_MS=86400000
